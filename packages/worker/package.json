{
  "name": "@ypr/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Preference-independent public catalog: crawls, stores with a TTL, and serves",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply catalog --local",
    "migrate:remote": "wrangler d1 migrations apply catalog --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ypr/shared": "workspace:*",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.125.0"
  }
}
