{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    // WXT turns this on; the rest of the workspace does not. Keeping one setting across
    // packages matters because core/ is typechecked through this project too.
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*", "test/**/*", "wxt.config.ts", "vitest.config.ts", ".wxt/**/*"]
}
