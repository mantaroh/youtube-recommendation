{
  "name": "@ypr/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser extension holding the local preference store, ranker and feed",
  "scripts": {
    "dev": "node tools/copy-onnx-runtime.mjs && wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "node tools/copy-onnx-runtime.mjs && wxt build && wxt build -b firefox",
    "build:chrome": "node tools/copy-onnx-runtime.mjs && wxt build",
    "build:firefox": "node tools/copy-onnx-runtime.mjs && wxt build -b firefox",
    "zip": "wxt zip",
    "prepare:wxt": "wxt prepare",
    "test": "vitest run",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@ypr/core": "workspace:*",
    "@ypr/shared": "workspace:*",
    "dexie": "^4.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  }
}
