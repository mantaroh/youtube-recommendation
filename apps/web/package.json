{
  "name": "@ypr/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The SPA and the Worker API, deployed together on Cloudflare",
  "scripts": {
    "dev": "wrangler dev",
    "dev:ui": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply catalog --local",
    "migrate:remote": "wrangler d1 migrations apply catalog --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ypr/domain": "workspace:*",
    "hono": "^4.13.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.0.0",
    "vite": "^7.2.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.125.0"
  }
}
